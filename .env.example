# ThreatGraph X Configuration File
# Copy to .env and adjust variables for your environment

ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
APP_NAME=ThreatGraph X
API_V1_PREFIX=/api
JWT_SECRET=<YOUR_JWT_SECRET_HERE>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Relational Database (PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./threatgraph_x.db
POSTGRES_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/threatgraph_x
POSTGRES_SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threatgraph_x

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD_HERE>
USE_IN_MEMORY_GRAPH=true

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Optional Grounded AI Provider
AI_PROVIDER=local_mock
AI_API_KEY=optional_api_key_here
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048

# Storage Vault
EVIDENCE_VAULT_DIR=./data/evidence_vault
MAX_UPLOAD_SIZE_MB=25

# Demonstration Lab Mode
DEMO_LAB_MODE=true

# Seeded User Passwords (for synthetic data testing)
SEED_ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD_HERE>
SEED_HUNTER_PASSWORD=<YOUR_HUNTER_PASSWORD_HERE>
SEED_ANALYST_PASSWORD=<YOUR_ANALYST_PASSWORD_HERE>
SEED_VIEWER_PASSWORD=<YOUR_VIEWER_PASSWORD_HERE>
